# Team Portal 环境变量
# 复制为 .env 并填入真实值，切勿提交 .env 到 Git
# 生产部署必读: JWT__KEY 必须替换为随机串，否则每次重启后端所有登录会失效

# ── 域名（生产环境 HTTPS 必需）──
DOMAIN=team.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ── CORS 允许的域名（分号分隔）──
CORS__ORIGINS=https://team.yourdomain.com

# ── JWT 密钥（至少 32 字符，生产必改!生成示例: openssl rand -base64 48）──
JWT__KEY=change-me-to-a-random-string-at-least-32-chars

# ── 管理员初始账号（仅首次建库时生效）──
ADMIN__USERNAME=admin
ADMIN__PASSWORD=change-me

# ── DeepSeek AI ──
# 同时注入 backend(AISERVICE__*)与 ai-service(DEEPSEEK_API_KEY，compose 已做变量映射)
AISERVICE__DEEPSEEKKEY=sk-your-deepseek-key
AISERVICE__DEEPSEEKBASEURL=https://api.deepseek.com

# ── 百度网盘 OAuth（云备份，可留空则跳过云上传）──
BAIDU__APPKEY=your-baidu-app-key
BAIDU__SECRETKEY=your-baidu-secret-key
BAIDU__SIGNKEY=your-baidu-sign-key
