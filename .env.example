# Team Portal — environment variables
# Copy to .env and adjust for your deployment

# DeepSeek API (required for AI chat/search)
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JWT (change in production!)
JWT_KEY=team-portal-jwt-secret-change-in-production-use-random-32-chars
JWT_ISSUER=TeamPortal
JWT_AUDIENCE=TeamPortal

# Admin account (auto-created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Database
CONNECTIONSTRINGS__DEFAULT_CONNECTION=Data Source=/data/teamportal.db

# AI Service URL (internal docker network)
AISERVICE__BASEURL=http://ai-service:9001
