# Dependencies
web/node_modules/
web/.next/

# Build
**/bin/
**/obj/
src/TeamPortal/publish/

# Secrets (local dev only — use env vars in production)
src/TeamPortal/appsettings.Development.json
.env
.env.*
!.env.example
*.local

# Database (local dev)
**/*.db
**/*.db-shm
**/*.db-wal
src/TeamPortal/Data/backups/

# Python
**/__pycache__/
ai-service/.venv/

# Runtime data (uploads, baidu token, flight logs — never commit)
# 注意：必须用前导 / 精确匹配根目录的 data/，避免误伤 src/TeamPortal/Data/（源码目录）
/data/
!data/.gitkeep

# 明确排除：src/TeamPortal/Data/ 是源码目录，绝不能被上面的 data/ 规则忽略
!/src/TeamPortal/Data/
!/src/TeamPortal/Data/Models/
!/src/TeamPortal/Data/Models/*.cs

# Test / recovery artifacts
*.bak-test
*.corrupted
tmp_*.cs

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user

# Code intelligence
.codegraph/

# Runtime logs / test reports (开发期生成,不入仓)
logs/
!logs/.gitkeep
test-results/
!test-results/.gitkeep

# OS
.DS_Store
Thumbs.db

# HTTPS / Let's Encrypt
certbot/
deploy/nginx.prod.generated.conf
deploy/nginx.temp.conf
